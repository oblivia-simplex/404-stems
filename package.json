{
  "name": "sp404-stems",
  "version": "0.1.0",
  "description": "Export stems from SP-404MKII patterns and chains, and copy projects off the unit over USB",
  "license": "GPL-3.0-or-later",
  "author": "Olivia Lucca Fraser",
  "homepage": "https://github.com/oblivia-simplex/404-stems",
  "repository": {
    "type": "git",
    "url": "https://github.com/oblivia-simplex/404-stems.git"
  },
  "type": "module",
  "main": "dist/electron/main.js",
  "bin": {
    "sp404-stems": "dist/stems.js",
    "sp404-device": "dist/device.js"
  },
  "scripts": {
    "build": "tsc",
    "stems": "tsx src/stems.ts",
    "device": "tsx src/device.ts",
    "app": "tsc && electron .",
    "app:build": "tsc && electron-builder --mac --dir",
    "app:dmg": "tsc && electron-builder --mac dmg",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p . && tsc -p test",
    "dist:mac": "tsc && electron-builder --mac",
    "dist:win": "tsc && electron-builder --win",
    "dist:linux": "tsc && electron-builder --linux"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "org.sp404.stems",
    "productName": "SP-404 Stems",
    "files": [
      "dist/**/*",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "Olivia Lucca Fraser",
      "synopsis": "Export stems from SP-404MKII projects"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
